# Python
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.venv/

# Tooling caches
.direnv/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.claude/
CLAUDE.md

# LaTeX build intermediates: the .tex source and the .pdf are kept, everything
# a compile regenerates is not
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# Frozen binary artifacts of an experiment: pickles and figure sources are rebuilt
# by the experiment that owns them
*.pkl

# The project-local Postgres socket; its datadir lives under data/
.pg

# Large stores. Schemas are small and reviewable, so they are force-added back.
/data
research/assets/data
!data/metadata/*.sql

# Research runs submitted through the MCP: regenerable, and the dashboard serves
# them from disk rather than from git
output/

# Working space, one directory per task, plus .records/, which keeps every finding on this machine
scratchpad/

# temporary ignore
/benchmarks/
# New experiment runs are local; published historical artifacts remain versioned.
research/experiments/**/runs/

# Frontend builds and local configuration
node_modules/
.next/
.vercel/
.env
.env.*
!.env.example

# Terraform local state and working directories
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*_override.tf
*_override.tf.json
