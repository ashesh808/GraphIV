__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# project-local postgres socket dir (datadir lives under data/ which is already ignored)
.pg/

# data
data

# nomic model weights (gitignored like data/)
model/

# ai stuff
.claude/
CLAUDE.md

# superseded pre-rewrite code (old phase_1/2/3 + scratchpad/kg_rag*); kept on disk, untracked
.legacy/

# phase output / caches
phases/**/output/

# experiment raw runs (reproducible reports + figure PNGs); keep metrics/plots/READMEs
experiments/**/results/runs/
experiments/**/results/run.log
# bulky deep-run dumps (49M+, regenerable via experiments/rerun.sh)
experiments/showcase/runs/

# scratch workspace (prototypes + large generated outputs, multi-GB)
scratchpad/

# nix direnv build cache
.direnv/

# LaTeX build intermediates (keep .tex/.pdf/.md; drop the rest)
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.out

# per-experiment caches are kept (small, and the LLM judge labels are expensive to regenerate)

# ad-hoc manual phase-6 output samples (use experiments/showcase instead)
test/
