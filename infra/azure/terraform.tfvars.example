subscription_id = "00000000-0000-0000-0000-000000000000"
project_name    = "graphiv"
environment     = "dev"
location        = "westus2"

# First apply provisions infrastructure without starting an incompatible/missing image.
api_image_tag = null

# After publishing a Blob-capable image and populating the Key Vault secret:
# api_image_tag = "git-0123456789ab"
# llm_api_url   = "https://your-llm-provider.example/v1"
# llm_model     = "your-summary-model"

# The frontend library/find_runs also need report read/list access once Blob integration exists.
allow_report_reads = false

# Optional object ID for the offline artifact-uploading pipeline.
# publisher_principal_id = "00000000-0000-0000-0000-000000000000"

api_resources = { cpu = 1, memory = "2Gi" }
tags          = { owner = "research" }
