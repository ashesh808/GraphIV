subscription_id = "00000000-0000-0000-0000-000000000000"
project_name    = "graphiv"
environment     = "dev"
location        = "westus2"

# First apply provisions infrastructure without starting a missing image.
api_image_tag = null

# Default corpus: immutable snapshots in Azure Blob storage.
corpus_backend = "azure"

# Optional existing PostgreSQL corpus. No PostgreSQL server is created here.
# corpus_backend = "postgres"
# postgres_dsn_secret_name = "graphiv-postgres-dsn"
# api_environment = {
#   GRAPHIV_GRAPH_PATH = "/mnt/graphiv/citation_graph_export.npy"
# }
# The graph path must already exist in the image or mounted filesystem.
# Setting it does not download a graph or create a volume mount.

# After publishing a tested image and populating graphiv-api-token in Key Vault:
# api_image_tag = "git-0123456789ab"
# llm_api_url   = "https://your-llm-provider.example/v1"
# llm_model     = "your-summary-model"
# llm_api_key_secret_name = "llm-api-key"
# embedding_api_url = "https://your-embedding-provider.example/v1"
# embedding_model = "model-matching-the-corpus-snapshot"
# embedding_api_key_secret_name = "embedding-api-key"

# The frontend library/find_runs also need report read/list access for Blob-backed report reads.
allow_report_reads = false

# Optional object ID for the offline artifact-uploading pipeline.
# publisher_principal_id = "00000000-0000-0000-0000-000000000000"

api_resources = { cpu = 1, memory = "2Gi" }
tags          = { owner = "research" }

# Optional persistent corpus/model cache, using the existing account with no account keys.
# Creates a 100GiB-quota SMB share and mounts it at /var/lib/graphiv.
runtime_cache_share = false

# Optional manual offline job; creation never starts an execution.
# First publish a tested graphiv-index-builder:<tag> image into the same registry.
# Requires runtime_cache_share = true. Populate the HF read token outside Terraform.
# index_builder_image_tag = "builder-tested"
# hf_token_secret_name = "hf-read-token"
# Default command pins GraphIV-2026-10-01 and publishes an INACTIVE IVFSQ8 snapshot.
# Run actual-corpus quality benchmarks before explicitly adding --activate to a
# rerun of the same verified snapshot. The active runtime manifest stays unchanged
# until that explicit activation. No extra service is needed for the benchmark.

# Vercel AI Gateway alternative (populate this named Key Vault secret separately):
# llm_api_url = "https://ai-gateway.vercel.sh/v1"
# llm_model = "google/gemini-3.1-flash-lite"
# llm_api_key_secret_name = "vercel-ai-gateway-key"
# embedding_api_url = "https://ai-gateway.vercel.sh/v1"
# embedding_model = "openai/text-embedding-3-small"
# embedding_api_key_secret_name = "vercel-ai-gateway-key"
# api_environment = { GRAPHIV_EMBED_QUERY_PREFIX = "" }
# The corpus must use matching OpenAI embeddings; legacy Nomic vectors are incompatible.
