{
  "_doc": "Data locations + endpoint APIs shared by all phases. Repo-relative paths (no leading /) resolve against the repo root; absolute paths are used as-is. Single store = project Postgres+pgvector at ./data/pg (flake pg-init/pg-start; peer-auth socket, no secrets). `llm` is any OpenAI-compatible endpoint (we serve via llama-router: https://git.kuroma.dev/kkuroma/llama-router). `embeddings` absolute paths are BUILD-TIME inputs only (phases 4-5); the serve path needs nothing outside ./data + ./model.",
  "sqlite": {
    "db": "data/metadata/arxiv.db",
    "schemas": "data/metadata/schemas.sql"
  },
  "postgres": {
    "dsn_env": "ARXIVKG_PG_DSN",
    "socket_dir": ".pg",
    "port": 5433,
    "dbname": "arxivkg",
    "pg_schema": "data/metadata/pg_schema.sql",
    "citation_schema": "data/metadata/citation_schema.sql"
  },
  "llm": {
    "base_url": "http://localhost:11434/v1",
    "router": "http://localhost:11434",
    "map_model": "Gemma-4-26B",
    "narrator_model": "Gemma-4-26B-Code",
    "vision_model": "Gemma-4-26B-Vision"
  },
  "paths": {
    "arxiv_json": "data/arxiv.json",
    "html_dir": "data/html",
    "pdf_dir": "data/pdf",
    "topic_tree_db": "data/metadata/topic_tree_nomic.db",
    "fulltext_cache_db": "data/metadata/fulltext_cache.db",
    "community_summary_db": "data/metadata/community_summaries.db",
    "citation_stats": "data/citation_stats",
    "citation_labels": "data/citation_labels",
    "models": "data/models",
    "hf_cache": "data/models/hf_cache",
    "theme": "theme.json"
  },
  "embeddings": {
    "nomic_npy": "/mnt/Vault-Academics/the-great-arxiv-db/data/embeddings/embeddings_nomic.npy",
    "nomic_umap50_npy": "/mnt/Vault-Academics/the-great-arxiv-db/data/embeddings/embeddings_nomic_umap50.npy",
    "nomic_model": "model/nomic-embed-text-v2-moe",
    "old_sqlite": "/mnt/Vault-Academics/the-great-arxiv-db/data/arxiv_latest.db",
    "prompt": "Instruct: classifying the research topic of a paper's abstract.\nQuery:",
    "dim": 768,
    "rows": 2918448,
    "max_seq": 2048
  }
