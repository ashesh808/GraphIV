# The existing Python dashboard's read-only HTTP endpoints.
# Start it with: uv run graphiv-serve --http --role frontend
# An explicitly configured server shows connection errors instead of sample data.
# GRAPHIV_API_URL=http://127.0.0.1:6969

# With no value configured, the app tries localhost:6969 and displays clearly
# labeled example reports only when that local server cannot be reached.
